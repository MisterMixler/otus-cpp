# Doxygen configuration (generated by CMake)

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_BRIEF          = "OTUS C++: bulk command processor (Observer pattern)"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_PATH               = "@DOXYGEN_DOT_PATH@"

RECURSIVE              = YES
EXTRACT_ALL            = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/src/bulk/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/bulk"

FILE_PATTERNS          = *.h *.hpp *.cpp

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
